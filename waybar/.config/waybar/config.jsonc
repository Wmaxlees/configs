{
    "layer": "top",
    "modules-left": [
        "clock",
        "sway/window"
    ],
    "modules-center": [
        "sway/workspaces"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "battery",
        "cpu",
        "memory",
        "custom/gpuinfo"
    ],
    "sway/window": {
        "max-length": 50
    },
    "memory": {
        "format": "{percentage}% "
    },
    "cpu": {
        "format": "{usage}% "
    },
    "network": {
        "tooltip-format": "{bandwidthDownBytes}, {bandwidthUpBytes}",
        "format-wifi": "{essid} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "interval": 2,
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "min-length": 8,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format-charging": "{capacity}% "
    },
    "clock": {
        "format": "{:%Y-%m-%d %I:%M %p}",
        "min-length": 20,
        "max-length": 20
    },
    "pulseaudio": {
        "format": "{volume}% "
    },
    "custom/gpuinfo": {
        "format": "{} ",
        "exec": "~/.config/waybar/scripts/gpuinfo.sh",
        "return-type": "json",
        "interval": 2
    }
}